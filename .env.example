# Copy this file to .env, fill every secret, then run:
# chmod 600 .env

# Public URL that receives browser traffic, Telegram webhooks, Stripe webhooks,
# and delivery token redirects. Use HTTPS in production.
PUBLIC_BASE_URL=https://example.com
APP_VERSION=compose-local

# Local bind addresses for Docker-published ports.
# Keep WEB_BIND and OBS_BIND on 127.0.0.1 when a reverse proxy/tunnel is in front.
WEB_BIND=127.0.0.1
WEB_HTTP_PORT=8080
OBS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
PROMETHEUS_RETENTION=15d
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password

# Database.
POSTGRES_PASSWORD=change_this_postgres_password

# Telegram bot.
TELEGRAM_BOT_TOKEN=change_this_telegram_bot_token
TELEGRAM_BOT_USERNAME=YourBotUsername
TELEGRAM_WEBHOOK_SECRET=change_this_long_random_webhook_secret
ADMIN_TELEGRAM_IDS=

# Stripe.
STRIPE_SECRET_KEY=sk_live_change_this
STRIPE_WEBHOOK_SECRET=whsec_change_this

# Delivery links.
DELIVERY_TOKEN_TTL_MINUTES=60
DELIVERY_TOKEN_MAX_USES=3
DOWNLOAD_URL_SECRET=change_this_long_random_download_secret
DOWNLOAD_URL_TTL_SECONDS=1800
ENABLE_LEGACY_ONEDRIVE_DELIVERY=true

# Admin portal.
ADMIN_PORTAL_TOKEN=change_this_admin_portal_token
ADMIN_PORTAL_SESSION_HOURS=12
ADMIN_PORTAL_MAX_UPLOAD_MB=5120
